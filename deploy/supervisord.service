[Unit]
Description=Supervisor for Zhicuoben
Wants=network-online.target
Requires=mysqld.service
After=network-online.target mysqld.service

[Service]
Type=simple
RuntimeDirectory=supervisord
RuntimeDirectoryMode=0700
ExecStart=/opt/zhicuoben/supervisor-venv/bin/supervisord -n -c /etc/supervisord.conf
ExecReload=/opt/zhicuoben/supervisor-venv/bin/supervisorctl -c /etc/supervisord.conf reread
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
