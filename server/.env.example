# 复制为 .env 后按需修改
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# 数据库：默认 SQLite（instance/zhicuoben.db）。
# MySQL（docker compose up -d 后即可用；DDL 见 db/schema.mysql.sql）：
# DATABASE_URL=mysql+pymysql://zhicuoben:zhicuoben@127.0.0.1:3306/zhicuoben?charset=utf8mb4

# AI：auto（有 ANTHROPIC_API_KEY 用 Claude，否则 Mock）| claude | mock
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=gpt-6.1-sol
# 走 tu-zi 等 new-api 中转时设置（自动启用中转模式：标准 Messages 接口 + 提示词约束 JSON）
# ANTHROPIC_BASE_URL=https://api.tu-zi.com
# 强制开关中转模式（默认按 ANTHROPIC_BASE_URL 是否为官方域名判断）
# ANTHROPIC_RELAY_MODE=1

# 第二条大模型通道：DeepSeek 官方接口（OpenAI 兼容）。填了 DEEPSEEK_API_KEY 才启用；上面的 ANTHROPIC_* 通道照常保留
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 两条通道都配了时优先走哪条：deepseek（默认）| anthropic（切回 tu-zi 中转）
LLM_DEFAULT=deepseek
# 1 = 带照片的调用（扫描识别、讲解、擦除定位等）也发给 DeepSeek，模型支持图片输入时才开；默认 0，带照片的一律走 ANTHROPIC_* 通道
DEEPSEEK_VISION=0
# 思考强度：none（默认，不思考，整页约十几秒）| low | medium | high | default（不传，用模型默认；带思考整页要几分钟）
DEEPSEEK_REASONING_EFFORT=none
# 1（默认）= 纯文字链路：OCR 认题目和学生手写，整页还原、跨页作答、讲解只把 OCR 文字交给 DeepSeek，不再发照片；
# OCR 失败的页仍带照片走上面的 ANTHROPIC_* 通道。依赖插图的题文字条件不够时答案会写「需看图」。0 = 恢复照片 + OCR 一起发
DIGITIZE_TEXT_ONLY=1
# 1（默认）= 首选通道失败后自动换另一条再试；0 关闭
LLM_FALLBACK=1

# 知识图谱标注：1 = 识别完后把错题交给大模型挑 cn-math-taxonomy 里的知识点 id（错题榜按 id 归并）；默认 0 关闭
TAXONOMY_TAGGING=0

# 短信：mock 模式验证码固定 123456 并在接口回显
# off：手机号验证码登录关闭（只有审核账号能登）；aliyun：阿里云短信认证；mock：本地开发，验证码固定 123456
SMS_PROVIDER=off
# 阿里云短信认证（号码认证服务 → 短信认证）：AccessKey 建议用只授权 AliyunDypnsFullAccess 的 RAM 用户；签名和模板用控制台里的「赠送签名 / 赠送模板」
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# Apple 登录：1 = 用 Apple JWKS 公钥校验 identityToken（生产必须）；0 = 仅解码，本地联调用
APPLE_VERIFY=1
APPLE_BUNDLE_ID=com.zhicuoben.app

# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost
PORT=5001

# OCR：先逐行识别文字，再交给大模型分析。OCR_PROVIDER = paddle | baidu | off；留空自动（哪套配置齐了用哪套，paddle 优先）
OCR_PROVIDER=baidu
# 方案一 paddle：私有化部署的 PaddleOCR-VL（OpenAI Chat Completions 兼容）
OCR_BASE_URL=https://your-ocr-host
OCR_AUTH=user:password
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.6
# 方案二 baidu：百度智能云「试卷分析与识别」（能区分印刷 / 手写），填控制台应用的 API Key / Secret Key
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 微信小程序登录（小程序后台 → 开发管理 → 开发设置）
WX_APPID=
WX_SECRET=

# App Store 审核测试账号（固定手机号 + 固定验证码，不发短信）
REVIEW_PHONE=
REVIEW_CODE=

# 管理后台 https://<域名>/admin 的登录密码（不配置则后台不开放）
ADMIN_PASSWORD=

# 云同步：文件夹、试卷、电子版存 MySQL，照片存对象存储。0 = 关闭（同步接口返回 503，客户端只存本机）
SYNC_ENABLED=1
# 照片存储：cos（腾讯云对象存储）| local（服务器磁盘 UPLOAD_DIR/sync）；留空自动：下面四项配齐了用 cos
STORAGE_PROVIDER=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# 上传 / 下载签名链接有效期（秒）
SYNC_URL_EXPIRES=900

# ---- 学习计划 ----
# 转发到微信的链接用的公网地址（含前缀，如 https://example.com/zhicuoben）；留空用请求的域名
PUBLIC_BASE_URL=
# App 注册的 URL scheme（落地页用它唤起 App）和没装 App 时的下载地址
APP_URL_SCHEME=shangyike
APP_DOWNLOAD_URL=
